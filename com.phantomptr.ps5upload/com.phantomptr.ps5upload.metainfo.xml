<component type="desktop-application">
  <id>com.phantomptr.ps5upload</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>PS5Upload</name>
  <summary>Send games, apps and homebrew to a jailbroken PS5</summary>
  <developer id="com.phantomptr">
    <name>PhantomPtr</name>
  </developer>
  <description>
    <p>
      PS5Upload is a companion app for a jailbroken PS5. It sends games, apps and homebrew to
      the console, and manages it from your computer.
    </p>
    <ul>
      <li>Upload games and homebrew, and install packages</li>
      <li>Browse and manage the console's files and games</li>
      <li>Back up and restore saves, screenshots and clips</li>
      <li>Stream and play PS5 games, alone or with friends</li>
      <li>Use several computers and phones with one PS5</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.phantomptr.ps5upload.desktop</launchable>
