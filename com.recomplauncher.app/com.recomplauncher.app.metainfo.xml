  <name>RecompLauncher</name>
  <summary>Find, install, update and play PC recomps</summary>
  <developer id="com.recomplauncher">
    <name>Ripalda</name>
  </developer>
  <description>
    <p>
      RecompLauncher finds, installs, updates and starts PC recomps, native ports of console
      games, from each developer's own GitHub releases.
    </p>
    <p>
      No game files are included: every game needs your own copy, which the launcher finds in
      your folders.
    </p>
    <ul>
      <li>Browse the catalog and install recomps in one click</li>
      <li>Keep them up to date</li>
      <li>Install mods from Thunderstore and GameBanana</li>
      <li>Back up saves, and sync them with a RecompStore account</li>
      <li>Play Windows-only recomps through Proton</li>
      <li>Big Picture mode for controllers and Steam Deck</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.recomplauncher.app.desktop</launchable>
