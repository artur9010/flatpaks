  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Horizon</name>
  <summary>Launcher for Horizon, Minecraft: Java Edition rewritten in Rust</summary>
  <developer id="dev.playhorizon">
    <name>Ludovic Marie</name>
  </developer>
  <description>
    <p>
      Horizon is an unofficial, open-source reimplementation of Minecraft: Java Edition 26.3
      written in Rust. It uses the same worlds, rules and terrain as the Java game.
    </p>
    <p>
      This launcher installs Horizon builds, prepares them from your own copy of Minecraft and
      starts the client or a dedicated server. Horizon contains no Minecraft code or assets, so
      you need to own Minecraft: Java Edition.
    </p>
    <ul>
      <li>Install and switch between Horizon versions</li>
      <li>Sign in with a Microsoft account and download the game files from Mojang</li>
      <li>Browse mods, shader packs and resource packs</li>
      <li>Import modpacks and see what runs in Horizon</li>
      <li>Host servers for your friends</li>
    </ul>
  </description>
  <launchable type="desktop-id">dev.playhorizon.horizon.desktop</launchable>
  <url type="homepage">https://playhorizon.dev</url>
  <url type="bugtracker">https://github.com/horizon-rust/horizon/issues</url>
